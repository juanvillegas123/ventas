<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Ventas</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --font-main: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --bg-body: #fafafa;
            --bg-card: #ffffff;
            --border-subtle: #e4e4e7;
            --border-hover: #d4d4d8;
            --text-title: #09090b;
            --text-body: #27272a;
            --text-muted: #71717a;
            --color-primary: #18181b;
            --color-primary-hover: #27272a;
            --accent-emerald: #059669;
            --accent-blue: #2563eb;
            --accent-amber: #d97706;
            --accent-rose: #e11d48;
        }

        body {
            font-family: var(--font-main);
            background-color: var(--bg-body);
            color: var(--text-body);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        /* Minimalist Navbar */
        .site-header {
            background-color: #ffffff;
            border-bottom: 1px solid var(--border-subtle);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .site-logo {
            font-weight: 600;
            font-size: 0.98rem;
            letter-spacing: -0.02em;
            color: var(--text-title);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .site-logo-icon {
            width: 28px;
            height: 28px;
            background-color: #18181b;
            color: #ffffff;
            border-radius: 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .nav-link-minimal {
            color: var(--text-muted) !important;
            font-weight: 500;
            font-size: 0.88rem;
            padding: 0.45rem 0.8rem !important;
            border-radius: 6px;
            transition: all 0.15s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .nav-link-minimal:hover {
            color: var(--text-title) !important;
            background-color: #f4f4f5;
        }

        .nav-link-minimal.active {
            color: var(--text-title) !important;
            background-color: #f4f4f5;
            font-weight: 600;
        }

        /* Minimalist Buttons */
        .btn-minimal-dark {
            background-color: #18181b;
            color: #ffffff;
            border: 1px solid #18181b;
            font-weight: 500;
            font-size: 0.88rem;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .btn-minimal-dark:hover {
            background-color: #27272a;
            color: #ffffff;
            border-color: #27272a;
        }

        .btn-minimal-outline {
            background-color: #ffffff;
            color: var(--text-title);
            border: 1px solid var(--border-subtle);
            font-weight: 500;
            font-size: 0.88rem;
            border-radius: 8px;
            padding: 0.5rem 0.9rem;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .btn-minimal-outline:hover {
            background-color: #f4f4f5;
            border-color: var(--border-hover);
            color: var(--text-title);
        }

        .btn-minimal-danger {
            background-color: #fff1f2;
            color: #e11d48;
            border: 1px solid #ffe4e6;
            font-weight: 500;
            font-size: 0.88rem;
            border-radius: 8px;
            padding: 0.45rem 0.8rem;
            transition: all 0.15s ease;
        }

        .btn-minimal-danger:hover {
            background-color: #ffe4e6;
            color: #be123c;
        }

        /* Minimalist Cards */
        .card-minimal {
            background-color: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
            transition: border-color 0.15s ease;
        }

        .card-minimal:hover {
            border-color: var(--border-hover);
        }

        /* Minimalist Tables */
        .table-minimal {
            margin-bottom: 0;
        }

        .table-minimal thead th {
            font-size: 0.73rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-subtle);
            padding: 0.75rem 1rem;
            background-color: #fbfbfb;
        }

        .table-minimal tbody td {
            padding: 0.9rem 1rem;
            border-bottom: 1px solid var(--border-subtle);
            font-size: 0.88rem;
            vertical-align: middle;
        }

        .table-minimal tbody tr:last-child td {
            border-bottom: none;
        }

        .table-minimal tbody tr:hover td {
            background-color: #fcfcfc;
        }

        /* Badges */
        .badge-minimal {
            font-weight: 500;
            font-size: 0.75rem;
            padding: 0.25rem 0.55rem;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }

        .badge-minimal-success {
            background-color: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .badge-minimal-warning {
            background-color: #fffbeb;
            color: #92400e;
            border: 1px solid #fde68a;
        }

        .badge-minimal-danger {
            background-color: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .badge-minimal-neutral {
            background-color: #f4f4f5;
            color: #52525b;
            border: 1px solid #e4e4e7;
        }

        /* Inputs */
        .form-control-minimal, .form-select-minimal {
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
            padding: 0.55rem 0.85rem;
            font-size: 0.88rem;
            background-color: #ffffff;
            color: var(--text-title);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-control-minimal:focus, .form-select-minimal:focus {
            border-color: #18181b;
            box-shadow: 0 0 0 2px rgba(24, 24, 27, 0.08);
            outline: none;
        }

        main {
            flex: 1 0 auto;
        }

        .footer-minimal {
            background-color: #ffffff;
            border-top: 1px solid var(--border-subtle);
            padding: 1.25rem 0;
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="container d-flex justify-content-between align-items-center py-2">
            <div class="d-flex align-items-center gap-4">
                <a class="site-logo" asp-controller="Home" asp-action="Index">
                    <span class="site-logo-icon">V</span>
                    <span>VentasCore</span>
                </a>

                <nav class="d-none d-md-flex align-items-center gap-1">
                    <a class="nav-link-minimal" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i> Dashboard
                    </a>
                    <a class="nav-link-minimal" asp-controller="Ventas" asp-action="Index">
                        <i class="bi bi-receipt"></i> Ventas
                    </a>
                    <a class="nav-link-minimal" asp-controller="Productos" asp-action="Index">
                        <i class="bi bi-box"></i> Productos
                    </a>
                    <a class="nav-link-minimal" asp-controller="Categorias" asp-action="Index">
                        <i class="bi bi-tag"></i> Categorías
                    </a>
                    <a class="nav-link-minimal" asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                </nav>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Ventas" asp-action="Create" class="btn-minimal-dark text-decoration-none">
                    <i class="bi bi-plus-lg"></i> Nueva Venta
                </a>
            </div>
        </div>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="footer-minimal">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                <strong>VentasCore</strong> &mdash; Sistema de Ventas e Inventario
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge-minimal badge-minimal-neutral">
                    <i class="bi bi-circle-fill text-success" style="font-size: 0.45rem;"></i> Sistema Activo
                </span>
                <span>ASP.NET Core 10</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
