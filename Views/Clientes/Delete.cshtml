@model Cliente
@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> Volver a Clientes
            </a>
            <h1 class="h4 fw-bold text-dark mb-1">Eliminar Cliente</h1>
            <p class="text-muted small mb-0">Esta acción no se puede deshacer si el cliente no tiene ventas registradas.</p>
        </div>

        <div class="card-minimal p-4 border-danger border-opacity-25">
            <div class="mb-3">
                <div class="small text-muted text-uppercase" style="font-size: 0.72rem;">CLIENTE A ELIMINAR</div>
                <h5 class="fw-bold text-dark mt-1 mb-1">@Model.Nombre</h5>
                <span class="text-muted small">Tel: @(Model.Telefono ?? "Sin teléfono") | Email: @(Model.Email ?? "Sin email")</span>
            </div>

            <div class="alert alert-danger p-3 small mb-4" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i>
                ¿Estás seguro de que deseas eliminar este cliente? Si ya tiene ventas asociadas, el sistema no permitirá borrarlo para preservar el historial contable.
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-minimal-outline text-decoration-none">Cancelar</a>
                    <button type="submit" class="btn btn-danger btn-sm px-3">
                        Confirmar Eliminación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
