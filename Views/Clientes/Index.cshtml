@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Clientes</h1>
        <p class="text-muted small mb-0">Directorio de clientes y registro de compras.</p>
    </div>
</div>

<div class="card-minimal">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-people text-muted fs-1 opacity-50 d-block mb-2"></i>
                <p class="fw-semibold text-dark mb-1">No hay clientes registrados</p>
                <p class="text-muted small mb-0">Los clientes se registrarán automáticamente desde el Punto de Venta o el formulario.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-minimal align-middle">
                    <thead>
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Nombre</th>
                            <th>Teléfono</th>
                            <th>Correo Electrónico</th>
                            <th class="text-center">Compras</th>
                            <th class="text-end pe-3" style="width: 170px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">#@c.Id.ToString("D3")</td>
                                <td class="fw-medium text-dark">@c.Nombre</td>
                                <td class="text-muted small">@(c.Telefono ?? "Sin teléfono")</td>
                                <td class="text-muted small">@(c.Email ?? "Sin correo")</td>
                                <td class="text-center">
                                    <span class="badge-minimal badge-minimal-neutral">
                                        @(c.Ventas?.Count ?? 0) ventas
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn-minimal-outline text-decoration-none btn-sm py-1 px-2 me-1">
                                        Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn-minimal-danger text-decoration-none btn-sm py-1 px-2">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
