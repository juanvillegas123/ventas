@model sistema_ventas.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center align-items-center" style="min-height: 72vh;">
    <div class="col-12 col-sm-9 col-md-6 col-lg-4">
        
        <div class="text-center mb-4">
            <div class="site-logo-icon mx-auto mb-2" style="width: 44px; height: 44px; font-size: 1.25rem;">
                V
            </div>
            <h1 class="h4 fw-bold text-dark mb-1">VentasCore</h1>
            <p class="text-muted small mb-0">Ingresa tus credenciales para acceder al sistema</p>
        </div>

        <div class="card-minimal p-4 shadow-sm border">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <div asp-validation-summary="All" class="mb-0"></div>
                </div>
            }

            <form asp-action="Login" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label small fw-semibold text-dark">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="Usuario" class="form-control form-control-minimal border-start-0" 
                               placeholder="Ej. admin" style="border-radius: 0 8px 8px 0;" autofocus required />
                    </div>
                    <span asp-validation-for="Usuario" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold text-dark">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Password" type="password" id="passwordInput" class="form-control form-control-minimal border-start-0 border-end-0" 
                               placeholder="••••••••" required />
                        <button type="button" class="btn btn-outline-secondary border-start-0 bg-white text-muted" id="btnTogglePass" 
                                style="border-color: var(--border-subtle); border-radius: 0 8px 8px 0;" title="Mostrar/Ocultar contraseña">
                            <i class="bi bi-eye" id="iconTogglePass"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-minimal-dark w-100 justify-content-center py-2 mt-2">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar al Sistema
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center">
                <div class="d-inline-flex align-items-center gap-2 bg-light px-3 py-1 rounded-pill text-muted small" style="font-size: 0.78rem;">
                    <i class="bi bi-key-fill text-primary"></i>
                    <span>Acceso por defecto: <strong>admin</strong> / <strong>admin</strong></span>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const btnToggle = document.getElementById('btnTogglePass');
        const passInput = document.getElementById('passwordInput');
        const iconToggle = document.getElementById('iconTogglePass');

        if (btnToggle && passInput) {
            btnToggle.addEventListener('click', function() {
                if (passInput.type === 'password') {
                    passInput.type = 'text';
                    iconToggle.classList.remove('bi-eye');
                    iconToggle.classList.add('bi-eye-slash');
                } else {
                    passInput.type = 'password';
                    iconToggle.classList.remove('bi-eye-slash');
                    iconToggle.classList.add('bi-eye');
                }
            });
        }
    </script>
}
