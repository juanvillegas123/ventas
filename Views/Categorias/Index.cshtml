@model List<Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Categorías</h1>
        <p class="text-muted small mb-0">Organización y familias de productos para el catálogo.</p>
    </div>
    <a asp-action="Create" class="btn-minimal-dark text-decoration-none">
        <i class="bi bi-plus-lg"></i> Nueva Categoría
    </a>
</div>

<div class="card-minimal">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-minimal align-middle">
                <thead>
                    <tr>
                        <th style="width: 100px;">ID</th>
                        <th>Nombre de la Categoría</th>
                        <th class="text-end pe-3" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-muted fw-semibold">#@c.Id.ToString("D2")</td>
                            <td class="fw-medium text-dark">@c.Nombre</td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn-minimal-outline text-decoration-none btn-sm py-1 px-2 me-1" title="Editar">
                                    Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@c.Id" class="btn-minimal-danger text-decoration-none btn-sm py-1 px-2" title="Eliminar">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>